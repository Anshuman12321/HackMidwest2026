        "source_owner": {
          "person_id": null,
          "name": null,
          "resolution": "missing"
        },
        "visibility": "internal",
        "coverage": "native_imported",
        "excerpt": {
          "text": "We launched in Brazil earlier this year and have been onboarding Brazilian merchants onto monthly subscription plans. None of these subscriptions are renewing successfully. Subscriptions hit their renewal date, move to past_due, and no charge is attempted — no failure webhooks fire and dunning retries are not being scheduled. Manual charges via the API succeed on the same customers, confirming payment methods are valid. Our US subscriptions are unaffected. We need this resolved urgently and confirmation that affected subscriptions will be retried automatically — we cannot manually re-trigger hundreds of renewals.",
          "field_path": "original_record.description",
          "start": 0,
          "end": 620,
          "units": "unicode_code_points"
        }
      },

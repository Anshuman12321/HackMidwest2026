# Load only on the service host. Never include these values in Snap-kit JSON.
DATABASE_URL=postgresql://ripple:local-development-only@127.0.0.1:5432/ripple
RIPPLE_PUBLIC_URL=https://ripple.example.com
RIPPLE_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DEVREV_WORKSPACE_ID=1mWckJhGyy
# Trusted installation policy: comma-separated native DONs. No automatic grants.
RIPPLE_ACTOR_IDS=don:identity:dvrv-us-1:devo/1mWckJhGyy:devu/6
RIPPLE_ASSIGNABLE_OWNER_IDS=don:identity:dvrv-us-1:devo/1mWckJhGyy:devu/6
# Deployment-owned MCP endpoint supporting each caller's actor-session token.
DEVREV_MCP_URL=https://your-delegated-devrev-mcp-endpoint.example/mcp
AGENT_URL=https://your-investigation-agent.example
AGENT_BEARER=replace-with-the-agent-service-secret
HOST=127.0.0.1
PORT=8787

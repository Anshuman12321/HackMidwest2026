# Copy to apps/ripple/.env.local. This file contains examples, never credentials.
RIPPLE_LOCAL_MODE=read-only
PORT=8788
# Optional: Supabase PostgreSQL transaction/session pooler connection string.
# Download the official project CA from Supabase Database Settings.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=/absolute/path/to/supabase-ca.crt
# Keep this stable when using Supabase or moving the local database.
# RIPPLE_SECRET=generate-a-random-secret-of-at-least-32-characters
# Required for live read-only/local agent execution:
# RIPPLE_PYTHON=/path/to/python3.11-or-newer

# Connected mode requires the existing Ripple v2 HTTP agent contract.
# It does not translate an arbitrary DevRev workflow trigger into that contract.
# RIPPLE_LOCAL_MODE=connected
# DEVREV_WORKSPACE_ID=1mWckJhGyy
# RIPPLE_LOCAL_ISSUE_ID=don:core:dvrv-us-1:devo/1mWckJhGyy:issue/42
# RIPPLE_LOCAL_ACTOR_TOKEN=server-only-actor-token
# RIPPLE_ACTOR_IDS=administrator-reviewed-actor-DON
# RIPPLE_ASSIGNABLE_OWNER_IDS=administrator-reviewed-owner-DON
# DEVREV_MCP_URL=https://api.devrev.ai/mcp/v1
# AGENT_URL=https://existing-ripple-contract-service.example
# AGENT_BEARER=server-only-agent-bearer
